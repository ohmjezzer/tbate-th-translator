# =============================================================================
#  .env.example — ตัวอย่างไฟล์ตั้งค่าทั้งหมดของ Scanlation Engine v2
# =============================================================================
#
#  วิธีใช้:
#      1) คัดลอกไฟล์นี้เป็น .env
#             cp .env.example .env
#      2) เปิด .env แล้วใส่ค่าที่ต้องการ (อย่างน้อยควรใส่ API key ของ AI)
#      3) รัน pipeline ได้เลย — ระบบจะโหลด .env ให้อัตโนมัติ
#
#  หมายเหตุ:
#      - บรรทัดที่ขึ้นต้นด้วย # คือคอมเมนต์ (ปิดการใช้งาน)
#      - บรรทัดที่ "ว่างค่า" (เช่น KEY=) จะถูกมองว่า "ไม่ตั้ง" แล้วใช้ค่าดีฟอลต์
#      - ค่าที่ใส่ใน .env จะทับค่าดีฟอลต์ในโค้ด (แต่ env จริงในเชลล์จะทับ .env อีกที)
#      - ⚠️ ห้าม commit ไฟล์ .env (มี .gitignore กันไว้แล้ว)
#      - ไฟล์นี้ปลอดภัยที่จะ commit (เป็นแค่ตัวอย่าง ไม่มี key จริง)
#
#  เอกสาร: ดู SETUP.md | ตรวจความพร้อม: python scripts/check_env.py
# =============================================================================


# =============================================================================
#  [1] API KEY ของผู้ให้บริการ AI  (ใส่เฉพาะเจ้าที่จะใช้จริง)
# =============================================================================
#  ตั้งค่าตัวนี้คู่กับ SCANLATION_TRANSLATION_BACKEND / SCANLATION_TRANSLATION_MODEL
#  พิกัดสเตจ Translation (แปลข้อความ)

# --- Anthropic (Claude) — แนะนำ claude-3-5-sonnet ---
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=            # (ทางเลือก) ใช้เมื่อ authenticate ด้วย token แทน key

# --- OpenAI (GPT) — แนะนำ gpt-4o ---
OPENAI_API_KEY=

# --- Azure OpenAI (ต้องใส่ทั้ง key และ endpoint) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# --- Google Gemini (ใช้ได้ผ่าน API แบบ OpenAI-compatible) ---
GEMINI_API_KEY=
# GOOGLE_API_KEY=                  # ชื่อสำรองของ Gemini

# --- DeepSeek ---
DEEPSEEK_API_KEY=

# --- Groq (เร็วมาก) ---
GROQ_API_KEY=

# --- Mistral ---
MISTRAL_API_KEY=

# --- OpenRouter (รวมโมเดลหลายเจ้าผ่านคีย์เดียว) ---
OPENROUTER_API_KEY=

# --- Together AI ---
TOGETHER_API_KEY=

# --- xAI (Grok) ---
XAI_API_KEY=

# --- Perplexity ---
PERPLEXITY_API_KEY=

# --- Cohere ---
COHERE_API_KEY=

# --- Fireworks AI ---
FIREWORKS_API_KEY=

# --- Cerebras ---
CEREBRAS_API_KEY=

# --- Hugging Face (ใช้ดาวน์โหลดโมเดล/weights) ---
HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=          # ชื่อสำรองของ HF_TOKEN

# --- Replicate ---
REPLICATE_API_TOKEN=


# =============================================================================
#  [2] โปรไฟล์เครื่อง (ทางลัดตั้งค่าอุปกรณ์รวดเดียว)
# =============================================================================
#  SCANLATION_PROFILE=cpu      → ตั้ง SAM + Inpainting เป็น CPU และใช้ SAM รุ่น vit_b
#  SCANLATION_PROFILE=gpu      → ตั้ง SAM + Inpainting เป็น cuda
SCANLATION_PROFILE=

#  อุปกรณ์เดียวใช้ทั้งระบบ (ตั้งเฉพาะ SAM/Inpaint แยกด้านล่างจะทับค่านี้)
#  ค่า: cuda | cpu | mps
SCANLATION_DEVICE=


# =============================================================================
#  [3] Translation — สเตจแปล (LLM)
# =============================================================================
#  backend ที่รองรับ: anthropic | openai | deepseek | groq | openrouter |
#                     together | mistral | xai | gemini | perplexity | ollama
SCANLATION_TRANSLATION_BACKEND=anthropic

#  ชื่อโมเดล เช่น:
#    anthropic : claude-3-5-sonnet-latest / claude-3-7-sonnet-latest
#    openai    : gpt-4o / gpt-4.1
#    deepseek  : deepseek-chat
#    groq      : llama-3.3-70b-versatile
#    gemini    : gemini-2.5-pro
SCANLATION_TRANSLATION_MODEL=claude-3-5-sonnet-latest

SCANLATION_TRANSLATION_TEMPERATURE=0.3
SCANLATION_TRANSLATION_MAX_TOKENS=4096
SCANLATION_TRANSLATION_MAX_RETRIES=3
SCANLATION_TRANSLATION_TIMEOUT=120
SCANLATION_TARGET_LANG=Thai

#  endpoint ทางเลือก (ปล่อยว่าง = ใช้ค่าดีฟอลต์ของแต่ละเจ้า)
#  เช่น OpenRouter: https://openrouter.ai/api/v1  | Ollama: http://localhost:11434/v1
SCANLATION_TRANSLATION_BASE_URL=

#  ไฟล์บริบทเรื่อง (สำหรับคำแปลที่เป็นธรรมชาติ)
SCANLATION_CHARACTERS_PATH=config/characters.json
SCANLATION_GLOSSARY_PATH=config/glossary.json
SCANLATION_TRANSLATION_CACHE=.scanlation/translation_cache.json


# =============================================================================
#  [4] Detection & Masking — OCR + SAM
# =============================================================================
#  OCR: easyocr (แนะนำ) | tesseract
SCANLATION_OCR_ENGINE=easyocr
SCANLATION_OCR_LANGS=en
SCANLATION_OCR_MIN_CONFIDENCE=0.4
SCANLATION_MERGE_GAP=16

#  SAM: vit_h (แม่นสุด) | vit_l | vit_b (เบา/เร็ว)
SCANLATION_SAM_MODEL_TYPE=vit_h
SCANLATION_SAM_CHECKPOINT=weights/sam_vit_h_4b8939.pth
SCANLATION_SAM_EXPAND=6
SCANLATION_SAM_MASK_FILL_RATIO=0.45
SCANLATION_SAM_BUBBLE_WHITENESS=0.72
SCANLATION_USE_AUTO_MASK=false

#  อุปกรณ์ของ SAM (ทับค่า SCANLATION_DEVICE)
SCANLATION_SAM_DEVICE=


# =============================================================================
#  [5] Inpainting — ลบข้อความเดิม (LaMa)
# =============================================================================
#  วิธี: lama (แนะนำ) | iopaint | opencv | median
SCANLATION_INPAINT_METHOD=lama
SCANLATION_MASK_DILATE=8
SCANLATION_TEXT_DELTA=45
SCANLATION_OPENCV_RADIUS=4
SCANLATION_OPENCV_METHOD=telea
SCANLATION_PAD_TO_MULTIPLE=8

#  อุปกรณ์ของ LaMa (ทับค่า SCANLATION_DEVICE)
SCANLATION_INPAINT_DEVICE=


# =============================================================================
#  [6] Typesetting — จัดวางข้อความไทย (Pillow)
# =============================================================================
SCANLATION_FONT_REGULAR=fonts/Sarabun-Regular.ttf
SCANLATION_FONT_BOLD=fonts/Sarabun-Bold.ttf
SCANLATION_FONT_SFX=fonts/Sarabun-Bold.ttf
SCANLATION_MIN_FONT_SIZE=10
SCANLATION_MAX_FONT_SIZE=200
SCANLATION_LINE_SPACING=1.28
SCANLATION_PADDING_RATIO=0.14
SCANLATION_SFX_STROKE_RATIO=0.13
SCANLATION_AUTO_CONTRAST=true


# =============================================================================
#  [7] Download & Ingest — ดึงรูปจากเว็บ → บังคับ WebP
# =============================================================================
#  source: vortexscans | generic-html | generic-json
SCANLATION_DOWNLOAD_SOURCE=vortexscans
SCANLATION_DOWNLOAD_OUT_DIR=              # ว่าง = ใช้ SCANLATION_INPUT_DIR (orig)
SCANLATION_DOWNLOAD_PREFIX=page
SCANLATION_DOWNLOAD_START_INDEX=1
SCANLATION_WEBP_QUALITY=92
SCANLATION_WEBP_METHOD=6
SCANLATION_FORCE_WEBP=true
SCANLATION_DOWNLOAD_OVERWRITE=true
SCANLATION_DOWNLOAD_LIMIT=0               # 0 = ทั้งหมด
SCANLATION_DOWNLOAD_WORKERS=4
SCANLATION_DOWNLOAD_RETRIES=3
SCANLATION_DOWNLOAD_TIMEOUT=60
SCANLATION_DOWNLOAD_MAX_WIDTH=0           # 0 = คงขนาดเดิม
SCANLATION_DOWNLOAD_REFERER=
SCANLATION_IMAGE_URLS_FILE=               # สำหรับ generic-json
SCANLATION_SOURCE_REGEX=                  # สำหรับ generic-html
# SCANLATION_DOWNLOAD_CHUNK_SIZE=65536
# SCANLATION_DOWNLOAD_USER_AGENT=Mozilla/5.0 ...


# =============================================================================
#  [8] Paths — ตำแหน่งไฟล์/โฟลเดอร์
# =============================================================================
SCANLATION_INPUT_DIR=orig
SCANLATION_OUTPUT_DIR=out
SCANLATION_WORK_DIR=.scanlation
SCANLATION_FONTS_DIR=fonts
SCANLATION_CONFIG_DIR=config


# =============================================================================
#  [9] ตัวแปรของไลบรารีภายนอก (ถ้าต้องการปรับ)
# =============================================================================
#  บังคับให้ PyTorch ใช้ GPU ตัวที่ n (0,1,...) หรือปิด GPU ด้วย -1
# CUDA_VISIBLE_DEVICES=0
#  ตำแหน่งแคชโมเดลของ Hugging Face/Torch
# HF_HOME=~/.cache/huggingface
# TORCH_HOME=~/.cache/torch
#  ลด log ของไลบรารี
# TRANSFORMERS_VERBOSITY=error
# TOKENIZERS_PARALLELISM=false
